+name: Jobs - getonboard
+on:
+  workflow_dispatch:
+    inputs:
+      mode:
+        description: Auto publishes only explicitly activated sources
+        type: choice
+        options: [auto, dry-run, publish]
+        default: dry-run
+  schedule:
+    - cron: '32 6 * * *'
+permissions:
+  contents: read
+jobs:
+  source:
+    uses: ./.github/workflows/source-pipeline.yml
+    with:
+      source: getonboard
+      mode: ${{ github.event_name == 'schedule' && 'auto' || inputs.mode }}
+    secrets: inherit
